# Copy to .env and load it in your shell with:
# set -a; source .env; set +a

# Market data service
MARKET_DATA_SYMBOLS=AAPL.US,MSFT.US,NVDA.US,TSLA.US
MARKET_DATA_QUOTE_MAX_AGE_SECONDS=15
MARKET_DATA_HISTORICAL_PROVIDER=auto
# Comma-separated browser origins allowed to call the REST API.
# Keep this explicit; wildcard (*) is rejected.
MARKET_DATA_CORS_ORIGINS=http://localhost:5173
REDIS_URL=

# Leave blank to use yfinance for US historical daily/recent minute bars.
# When both Alpaca values are set, auto mode uses Alpaca for historical bars
# and enables the live quote collector.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Optional local JSON credential registry (for example market-intel/api_keys.json).
# Keep the real file outside Git and restrict it to mode 600.
API_KEYS_PATH=

# Dashboard browser overlay. Keep credentials out of VITE_* variables.
VITE_MARKET_DATA_URL=http://127.0.0.1:8000

# Agent paper portfolio
# Required for local `agent-portfolio` runs. Keep the real key only in `.env`.
ZHIPU_API_KEY=
# OpenRouter is preferred when this key is set. The free router is the default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional. When set, local runs load the previous Agent snapshot from this URL.
CLOUDFLARE_PUBLIC_URL=

# Optional R-Breaker data download credentials.
# TUSHARE_TOKEN_2 is tried first. Set TUSHARE_API_URL_2 explicitly for a proxy.
TUSHARE_TOKEN_2=
TUSHARE_API_URL_2=
TUSHARE_TOKEN=
TUSHARE_API_URL=
