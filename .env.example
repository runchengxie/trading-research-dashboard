# Copy to .env and load it in your shell with:
# set -a; source .env; set +a

# Market data service
MARKET_DATA_SYMBOLS=AAPL.US,MSFT.US,NVDA.US,TSLA.US
MARKET_DATA_QUOTE_MAX_AGE_SECONDS=15
MARKET_DATA_HISTORICAL_PROVIDER=auto
REDIS_URL=

# Leave blank to use yfinance for US historical daily/recent minute bars.
# When both Alpaca values are set, auto mode uses Alpaca for historical bars
# and enables the live quote collector.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Optional local JSON credential registry (for example market-intel/api_keys.json).
# Keep the real file outside Git and restrict it to mode 600.
API_KEYS_PATH=

# Dashboard browser overlay. Keep credentials out of VITE_* variables.
VITE_MARKET_DATA_URL=http://127.0.0.1:8000

# Optional R-Breaker data download credential.
TUSHARE_TOKEN=
