{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runchengxie/trading-research-dashboard/schemas/conditional-research-v1.schema.json",
  "title": "Contextual conditional research summary",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "dateRange", "sourceSnapshots", "quality", "coverage", "groups", "provenance"],
  "properties": {
    "schemaVersion": {"const": "trading_research.conditional_research.v1"},
    "generatedAt": {"type": "string", "minLength": 1},
    "dateRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "additionalProperties": false
    },
    "sourceSnapshots": {"type": "integer", "minimum": 0},
    "quality": {
      "type": "object",
      "required": ["status", "warnings"],
      "properties": {
        "status": {"enum": ["pass", "warning"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["requestedSnapshots", "evaluatedSnapshots", "skippedSnapshots", "setupSamples", "strategySamples"],
      "properties": {
        "requestedSnapshots": {"type": "integer", "minimum": 0},
        "evaluatedSnapshots": {"type": "integer", "minimum": 0},
        "skippedSnapshots": {"type": "integer", "minimum": 0},
        "setupSamples": {"type": "integer", "minimum": 0},
        "strategySamples": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimensions", "metrics"],
        "properties": {
          "dimensions": {
            "type": "object",
            "required": ["instrument", "market", "session", "dayArchetype", "eventType", "referenceLevelKind", "strategyId", "variantId"],
            "properties": {
              "instrument": {"type": ["string", "null"]},
              "market": {"enum": ["CN", "HK", "US", null]},
              "session": {"type": ["string", "null"]},
              "dayArchetype": {"type": ["string", "null"]},
              "eventType": {"type": ["string", "null"]},
              "referenceLevelKind": {"type": ["string", "null"]},
              "strategyId": {"type": ["string", "null"]},
              "variantId": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "required": ["sampleCount", "winRate", "expectancy", "meanReturn", "meanMfe", "meanMae", "dateCount", "instrumentCount"],
            "properties": {
              "sampleCount": {"type": "integer", "minimum": 1},
              "winRate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "expectancy": {"type": ["number", "null"]},
              "meanReturn": {"type": ["number", "null"]},
              "meanMfe": {"type": ["number", "null"]},
              "meanMae": {"type": ["number", "null"]},
              "dateCount": {"type": "integer", "minimum": 1},
              "instrumentCount": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "definitionVersion"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "definitionVersion": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
