{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runchengxie/trading-research-dashboard/schemas/research-experiment.v1.schema.json",
  "title": "Research experiment definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "objective",
    "taskType",
    "market",
    "createdAt",
    "caseSet",
    "baselineVariantId",
    "variants",
    "scorecard",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {"const": "trading_research.research_experiment.v1"},
    "experimentId": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "taskType": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "minLength": 1},
    "caseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "baselineVariantId": {"type": "string", "minLength": 1},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variantId", "label", "kind"],
        "properties": {
          "variantId": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "numeric_baseline",
              "single_agent",
              "multi_agent",
              "model",
              "harness",
              "custom"
            ]
          },
          "model": {"type": "string", "minLength": 1},
          "harness": {"type": "string", "minLength": 1},
          "promptVersion": {"type": "string", "minLength": 1},
          "configurationRef": {"type": "string", "minLength": 1}
        }
      }
    },
    "scorecard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "label", "direction", "unit", "required"],
        "properties": {
          "metricId": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "direction": {"enum": ["maximize", "minimize", "target"]},
          "unit": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "threshold": {"type": "number"}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  }
}
