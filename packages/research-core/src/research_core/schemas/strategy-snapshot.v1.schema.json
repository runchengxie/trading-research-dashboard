{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runchengxie/a-share-trading-research/schemas/strategy-snapshot-v1.schema.json",
  "title": "Generic cross-strategy research snapshot envelope",
  "description": "Versioned wire contract trading_research.strategy_snapshot.v1. Strategy-specific payloads may be embedded under source for dedicated rendering.",
  "type": "object",
  "required": [
    "schemaVersion",
    "strategy",
    "generatedAt",
    "dataDate",
    "quality",
    "provenance",
    "coverage",
    "variants"
  ],
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "metricsMap": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "null"]
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "label", "metrics"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "symbols": {
          "type": "integer",
          "minimum": 0
        },
        "foldRows": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/metricsMap"
        }
      },
      "additionalProperties": false
    },
    "rollingSummary": {
      "type": "object",
      "required": ["variant", "foldId", "symbols", "metrics"],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "foldId": {
          "type": "integer",
          "minimum": 0
        },
        "symbols": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/metricsMap"
        }
      },
      "additionalProperties": false
    },
    "detailItem": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "detailGroup": {
      "type": "object",
      "required": ["id", "label", "items"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detailItem"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "trading_research.strategy_snapshot.v1"
    },
    "strategy": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "dataDate": {
      "$ref": "#/$defs/isoDate"
    },
    "quality": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pass", "warning"]
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["researchCommit", "oosSchemaVersion"],
      "properties": {
        "researchCommit": {
          "$ref": "#/$defs/nullableString"
        },
        "dataPlatform": {
          "type": "string",
          "minLength": 1
        },
        "dataPlatformSchemaVersion": {
          "$ref": "#/$defs/nullableString"
        },
        "dataPlatformGeneratedAt": {
          "$ref": "#/$defs/nullableString"
        },
        "oosSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "oosGeneratedAt": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["requested", "evaluated", "skipped"],
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "walkForward": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["trainBars", "testBars", "stepBars", "semantics", "summaries"],
          "properties": {
            "trainBars": {
              "type": "integer",
              "minimum": 0
            },
            "testBars": {
              "type": "integer",
              "minimum": 0
            },
            "stepBars": {
              "type": "integer",
              "minimum": 0
            },
            "semantics": {
              "type": "string",
              "minLength": 1
            },
            "summaries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rollingSummary"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "executionTiming": {
      "$ref": "#/$defs/nullableString"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "details": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/detailGroup"
      }
    },
    "source": {
      "type": "object",
      "required": ["wireVersion", "payload"],
      "properties": {
        "wireVersion": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
